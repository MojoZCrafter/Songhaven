  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d7a051f7cf7518c4287dc1c75bb8eea4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textComponent: {fileID: 1385497493}
  lines:
  - Good to see you, man
  - "I\u2019ve been so lonely since Bag was taken"
  - "I was cross for a while\u2026"
  - Cursing the percussionists for taking my brother
  - But now, I just feel empty inside
  - And despite what you think, things will only get worse
  - "The police will keep coming until there isn\u2019t a single person left in the
    outskirts"
  - ...
  - How about you try again to get some food
  - Search the outskirts, will ya?
  textSpeed: 0.05
